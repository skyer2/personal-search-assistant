# Research Agent Harness 环境变量示例
# Search 只是 environment tool，不是产品。复制为 .env 后按本机实际密钥调整。

# LLM 配置（OpenAI Chat Completions 兼容；本仓库不走 Anthropic / Responses）
# 默认：阿里云百炼
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max
# LLM HTTP 超时（秒，默认 120）
LLM_TIMEOUT_SEC=120

# 火山 AI 网关（蓝区 / 外部接入蓝区模型：用 Chat 格式 /v1，不要 /v1/responses，不要 /compatible）
# 须断开 XGate；密钥向网关重新申请。模型名填控制台里的 ID，例如 doubao-seed-1-6 / deepseek-v3
# OPENAI_BASE_URL=https://st8tp3ajl0df3n8b8l8qu.apigateway-cn-beijing.volceapi.com/v1
# OPENAI_API_KEY=网关新发的key
# LLM_QWEN_MAX=控制台里的模型ID
# LLM_COMPRESSION_MODEL=可用的轻量模型ID
# LLM_TIMEOUT_SEC=180

# Tavily 配置（SEARCH / RESEARCH 路径）
# 在 https://app.tavily.com/ 注册账号，然后创建 API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY
# Tavily HTTP 超时（秒，默认 120；官方 search 上限约 120）
TAVILY_TIMEOUT_SEC=120

# BrowseComp-Plus 固定语料评测（开启后 internet_search 不访问 Tavily）
# BROWSECOMP_PLUS_ENABLED=true
# BROWSECOMP_PLUS_CORPUS_DB=.benchmark_data/browsecomp_plus/corpus.sqlite3
# BROWSECOMP_PLUS_RETRIEVAL_LOG=tests/eval/results/browsecomp_plus/retrieval_log.jsonl
# BROWSECOMP_PLUS_TOP_K=5
# BROWSECOMP_PLUS_MAX_CONTEXT_CHARS=2048

# Harness 压缩模型（默认 qwen-turbo；设为 false 可禁用 LLM 压缩）
LLM_COMPRESSION_MODEL=qwen-turbo
HARNESS_LLM_COMPRESSION=true

# Token 预算按实际模型 tokenizer 计（默认 glm-5.2：中文≈1 字 1 token）
HARNESS_TOKEN_MODEL=glm-5.2

# Personal Research Memory（可选；未安装 mem0 时自动降级 SQLite/JSON）
# MEM0_ENABLED=true
# HARNESS_MEMORY_PROVIDER=sqlite   # sqlite | local | postgres | mem0
# HARNESS_MEMORY_DSN=postgresql://user:pass@host:5432/memory

# HARNESS_MEMORY_ENABLED=false
# HARNESS_MEMORY_USER_ID=me
# HARNESS_MEMORY_TENANT_ID=local
# HARNESS_MEMORY_PROJECT_ID=Inbox

# 图运行时（默认开启；不要再打开 LoopState 双 checkpoint）
# HARNESS_GRAPH_RUNTIME=true
# HARNESS_PERSIST_LOOP_STATE=false
# HARNESS_GRAPH_CHECKPOINT_PATH=output/.harness/graph_checkpoints.sqlite

# 可观测性（可选；未配置时自动降级）
# HARNESS_LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# Trace 默认不落完整 prompt/网页；debug 时才开 full
# OBS_CONTENT_MODE=redacted
# HARNESS_EVAL_VARIANT=full_harness
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# HITL（个人默认关闭）
# HARNESS_HITL_ENABLED=false
